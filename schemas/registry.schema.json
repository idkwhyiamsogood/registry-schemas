            "properties": {
              "path": {
                "type": "string"
              },
              "manifest": {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string"
                  },
                  "layer": {
                    "type": "string",
                    "enum": [
                      "api",
                      "modules",
                      "services",
                      "shared",
                      "entities"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "group",
                      "file"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "private": {
                    "type": "boolean"
                  },
                  "files": {
