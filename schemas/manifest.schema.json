{
  "$ref": "#/definitions/ManifestSchema",
  "definitions": {
    "ManifestSchema": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "api",
            "modules",
            "services",
            "shared",
            "entities"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "group",
            "file"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "private": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "targetName": {
                "type": "string"
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "external": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "internal": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "layer",
        "type",
        "name",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
